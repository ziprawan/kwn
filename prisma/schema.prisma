datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Toilet {
  id             String   @id @default(cuid())
  name           String
  latitude       Float
  longitude      Float
  imagePath      String?
  updatedByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  addedBy   String?
  createdAt DateTime @default(now())
}
