# Path database SQLite (relatif terhadap folder prisma/, sehingga ../data/ menyimpan DB di root ./data/)
DATABASE_URL="file:../data/peta-toilet.db"

# URL aplikasi (ubah sesuai domain saat deploy)
APP_URL="http://localhost:3000"

# Slug tersembunyi untuk halaman login & panel admin (contoh: http://localhost:3000/kelola-toilet)
ADMIN_PORTAL_SLUG="kelola-toilet"

# Secret acak minimal 32 karakter untuk menandatangani cookie sesi JWT
AUTH_SECRET="ganti-dengan-random-secret-minimal-32-karakter"

# Kredensial Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Daftar email Google super-admin awal (pisahkan dengan koma jika lebih dari satu)
ADMIN_EMAILS="emailanda@gmail.com"

# Opsional khusus local development (diabaikan saat NODE_ENV=production)
DEV_MOCK_LOGIN="false"
